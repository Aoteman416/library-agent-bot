# =====================================================================
# 图书馆智能客服 - 环境变量示例（复制为 .env 后按需修改）
# 对应需求分析 v2 的技术配置
# =====================================================================

# ---- 服务 ----
APP_NAME=LibrarySmartService
APP_VERSION=2.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ---- LLM（选一个 Provider，或手动填 BASE_URL/MODEL/KEY）----
# LLM_PROVIDER=siliconflow | dashscope | qianfan | doubao | oneapi | openai
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=30
CHAT_FALLBACK_TO_LLM=true

# ---- RAG ----
# embedding: ngram(零依赖稀疏) | external(稠密 BGE)
EMBEDDING_MODE=ngram
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
# 向量库: memory(进程内) | chroma(持久化)
VECTOR_STORE_MODE=memory
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=library_knowledge
TOP_K=10
RERANK_TOP_N=3
CHUNK_SIZE=200
CHUNK_OVERLAP=50

# 重排序（Cross-Encoder，对应 v2 3.1 Step3）
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_BATCH_SIZE=32

# ---- 缓存（语义缓存 Redis 后端，对应 v2 9.1）----
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL=3600
REDIS_MAX_SIZE=500

# ---- 关系数据库（MySQL / 兼容 SQLite 演示，对应 v2 5.1）----
# DB_ENABLED=true 时使用 DATABASE_URL 指向的库；false 时用内存 SQLite 演示
DB_ENABLED=false
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/library_service
DB_DEMO_MODE=true

# ---- 鉴权（JWT + Refresh Token，对应 v2 9.1）----
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_USER_ID=admin
ADMIN_PASSWORD=admin123

# ---- 限流（对应 v2 9.1 rate_limiting）----
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_USER=30
RATE_LIMIT_PER_IP=100
RATE_LIMIT_WINDOW_SECONDS=60
